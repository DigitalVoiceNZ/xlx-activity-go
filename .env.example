# Activity Monitor Configuration
# Copy this file to .env and edit to suit

# System identifier
SYSTEM_NAME=299

# Timezone for timestamp parsing - must be a valid IANA timezone
TIMEZONE=Pacific/Auckland

# Path to the SQLite database file
DB_PATH=./pb_data/data.db

# Address and port for the SSE (Server-Sent Events) server
# Format: :port or host:port
SSE_ADDR=:8080

# Path to the system log file to monitor
LOG_PATH=/var/log/syslog

# Log level for the application (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
